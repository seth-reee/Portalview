pkgname=portalview
pkgver=0.1.0
pkgrel=1
pkgdesc='Qt Quick remote desktop connection manager for Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/seth-reee/Portalview'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'freerdp' 'gcc-libs' 'glibc')
optdepends=('qt6-wayland: native Wayland support' 'omarchy: live desktop theme integration')
makedepends=('cmake' 'ninja' 'gcc')
options=('!debug')
# SRCDEST can hold the pinned archive before the release is published.
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('0333033cc3d83e02426f44dec53004a4194b03606cad28aa42f6d5fd25fb0a8b')

build() {
  cmake -S "$srcdir/Portalview-$pkgver" -B "build-$pkgver" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_TESTING=ON
  cmake --build "build-$pkgver" --parallel 2
}

check() {
  ctest --test-dir "build-$pkgver" --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install "build-$pkgver"
}
